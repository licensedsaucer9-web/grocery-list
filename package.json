{
  "name": "grocery-list",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:sync",
    "build:sync": "esbuild scripts/sync.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist-sync/sync.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "sync": "node scripts/sync.ts",
    "sync:sample": "node scripts/sync.ts --sample",
    "icons": "sh scripts/make-icons.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
